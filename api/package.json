{
  "name": "@songcollector/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/functions.js",
  "scripts": {
    "build": "esbuild src/functions.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/functions.js --external:@azure/cosmos --external:@azure/functions --external:@azure/functions-core",
    "dev": "npm run build && func start",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/cosmos": "^4.4.1",
    "@azure/functions": "^4.7.2",
    "@songcollector/shared": "0.1.0",
    "write-file-atomic": "^6.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "esbuild": "^0.25.8",
    "tsx": "^4.20.3"
  }
}
